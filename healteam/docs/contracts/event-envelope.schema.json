{
  "$defs": {
    "Actor": {
      "description": "Who emitted an event or who is allowed to speak.\n\nNote: `trainee` is the human learner playing the therapist role.",
      "enum": [
        "doctor",
        "psychiatrist",
        "observer",
        "father",
        "mother",
        "patient",
        "trainee",
        "system"
      ],
      "title": "Actor",
      "type": "string"
    },
    "EventSource": {
      "enum": [
        "human",
        "ai",
        "system"
      ],
      "title": "EventSource",
      "type": "string"
    },
    "EventVisibility": {
      "enum": [
        "public",
        "learner",
        "supervisor",
        "internal"
      ],
      "title": "EventVisibility",
      "type": "string"
    },
    "StreamEventType": {
      "enum": [
        "status_changed",
        "utterance",
        "hint",
        "report_ready",
        "error",
        "model_call_started",
        "model_call_finished"
      ],
      "title": "StreamEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "round": {
      "maximum": 30,
      "minimum": 0,
      "title": "Round",
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/StreamEventType"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "visibility": {
      "$ref": "#/$defs/EventVisibility"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "session_id",
    "seq",
    "round",
    "type",
    "actor",
    "source",
    "visibility",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
