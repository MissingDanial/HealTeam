{
  "$defs": {
    "DimensionId": {
      "enum": [
        "participation",
        "exploration",
        "school_consistency",
        "collaborative_next_step"
      ],
      "title": "DimensionId",
      "type": "string"
    },
    "DimensionRating": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/DimensionId"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rating"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_seq": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "title": "Evidence Seq",
          "type": "array"
        }
      },
      "required": [
        "dimension_id",
        "rating",
        "rationale"
      ],
      "title": "DimensionRating",
      "type": "object"
    },
    "MilestoneRating": {
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Milestone Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "not_observed",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_seq": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "title": "Evidence Seq",
          "type": "array"
        }
      },
      "required": [
        "milestone_id",
        "status",
        "rationale"
      ],
      "title": "MilestoneRating",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionRating"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Dimensions",
      "type": "array"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/MilestoneRating"
      },
      "maxItems": 20,
      "title": "Milestones",
      "type": "array"
    },
    "rubric_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "rubric_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Hash",
      "type": "string"
    },
    "reviewed_event_seq": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 3000,
      "minItems": 1,
      "title": "Reviewed Event Seq",
      "type": "array"
    },
    "total_utterances": {
      "maximum": 3000,
      "minimum": 1,
      "title": "Total Utterances",
      "type": "integer"
    }
  },
  "required": [
    "dimensions",
    "rubric_version",
    "rubric_hash",
    "reviewed_event_seq",
    "total_utterances"
  ],
  "title": "Assessment",
  "type": "object"
}
