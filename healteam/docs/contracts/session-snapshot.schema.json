{
  "$defs": {
    "ModelMode": {
      "enum": [
        "mock",
        "live"
      ],
      "title": "ModelMode",
      "type": "string"
    },
    "ReportState": {
      "enum": [
        "not_started",
        "generating",
        "ready",
        "failed",
        "cancelled"
      ],
      "title": "ReportState",
      "type": "string"
    },
    "School": {
      "description": "Therapeutic school (流派). Locked at session start.",
      "enum": [
        "structural",
        "bowen",
        "satir"
      ],
      "title": "School",
      "type": "string"
    },
    "SessionMode": {
      "enum": [
        "training",
        "demo"
      ],
      "title": "SessionMode",
      "type": "string"
    },
    "SessionPhase": {
      "enum": [
        "simulation",
        "supervision",
        "report"
      ],
      "title": "SessionPhase",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "created",
        "awaiting_input",
        "running",
        "cancelling",
        "completed",
        "cancelled",
        "failed",
        "interrupted"
      ],
      "title": "SessionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "case_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Case Version",
      "type": "string"
    },
    "school": {
      "$ref": "#/$defs/School",
      "default": "structural"
    },
    "mode": {
      "$ref": "#/$defs/SessionMode",
      "default": "training"
    },
    "model_mode": {
      "$ref": "#/$defs/ModelMode",
      "default": "mock"
    },
    "state": {
      "$ref": "#/$defs/SessionState",
      "default": "created"
    },
    "phase": {
      "$ref": "#/$defs/SessionPhase",
      "default": "simulation"
    },
    "max_rounds": {
      "default": 10,
      "maximum": 30,
      "minimum": 1,
      "title": "Max Rounds",
      "type": "integer"
    },
    "current_round": {
      "default": 0,
      "maximum": 30,
      "minimum": 0,
      "title": "Current Round",
      "type": "integer"
    },
    "last_event_seq": {
      "default": 0,
      "minimum": 0,
      "title": "Last Event Seq",
      "type": "integer"
    },
    "report_state": {
      "$ref": "#/$defs/ReportState",
      "default": "not_started"
    }
  },
  "required": [
    "session_id",
    "case_id",
    "case_version"
  ],
  "title": "SessionSnapshot",
  "type": "object"
}
