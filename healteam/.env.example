# ─────────────────────────────────────────────────────────────────────────────
# HealTeam — environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
# API key. Required for W2+. W1 does not call any LLM.
OPENAI_API_KEY=

# Base URL for an OpenAI-compatible endpoint. Leave empty to use the
# official OpenAI endpoint. Set this to talk to DeepSeek, 通义千问, vLLM, etc.
# Examples:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://localhost:11434/v1          (Ollama)
OPENAI_BASE_URL=

# Anthropic-compatible endpoint used by the live multi-agent session runner.
# Leave blank to keep the session runner in placeholder mode.
ANTHROPIC_BASE_URL=

# Required to enable live Anthropic-compatible calls in `session_runner.py`.
ANTHROPIC_AUTH_TOKEN=

# Optional override for the live session model.
ANTHROPIC_MODEL=

# Default chat model. Must be supported by the base URL above.
LLM_MODEL=gpt-4o-mini

# Sampling parameters.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# ── Database (Postgres 16 + pgvector) ────────────────────────────────────────
# Used by the FastAPI service via SQLAlchemy / asyncpg in W2+.
DATABASE_URL=postgresql+asyncpg://healteam:healteam@postgres:5432/healteam

# Plain env vars consumed by the postgres container directly.
POSTGRES_USER=healteam
POSTGRES_PASSWORD=healteam
POSTGRES_DB=healteam
POSTGRES_PORT=5432

# ── Web (Next.js) ───────────────────────────────────────────────────────────
# The URL the browser uses to reach the FastAPI service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Service ports (host-side) ───────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
