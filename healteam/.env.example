# Local training defaults are explicitly offline. Copy to .env if needed.
# Credentials belong only in the local .env file, never source or browser data.
HEALTEAM_MODEL_MODE=mock
HEALTEAM_LLM_PROVIDER=anthropic
HEALTEAM_LLM_API_KEY=
HEALTEAM_LLM_BASE_URL=
HEALTEAM_LLM_MODEL=
HEALTEAM_LLM_TEMPERATURE=0.7
HEALTEAM_LLM_MAX_TOKENS=1024
HEALTEAM_REVIEW_MAX_TOKENS=4096
HEALTEAM_LLM_SEND_TEMPERATURE=false
HEALTEAM_LLM_MAX_RESPONSE_BYTES=262144
HEALTEAM_MODEL_MAX_CALLS=128
HEALTEAM_MODEL_TOKEN_BUDGET=250000
HEALTEAM_CONTEXT_MAX_CHARS=30000
HEALTEAM_LLM_TIMEOUT_SECONDS=60

# S2 bounded generation, stopping and SQLite writer-lock waits (seconds).
HEALTEAM_OPERATION_TIMEOUT_SECONDS=60
HEALTEAM_STOP_TIMEOUT_SECONDS=2
HEALTEAM_STORAGE_BUSY_TIMEOUT_SECONDS=2

# Optional root containing data/cases, data/schools and packages/prompts.
# The start script locates the source root automatically.
HEALTEAM_ROOT=

# Optional persistent SQLite file/URL. Empty defaults to data/healteam.sqlite3.
# Local training uses a file database, not PostgreSQL or an in-memory database.
HEALTEAM_DATABASE_URL=

# Manual development API address. Managed S5 uses the verified build manifest
# (default internal API 18000); rebuild with prepare_local.py --api-port to change it.
HEALTEAM_API_INTERNAL_URL=http://127.0.0.1:8000
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO

# S3 supports mock (default) and live. Keep keys only in private .env.
# DeepSeek: provider=deepseek, base=https://api.deepseek.com/v1, model=deepseek-flash.
# OpenAI uses Chat Completions; Anthropic uses Messages.
# Non-empty unified variables
# override same-provider legacy names: ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN,
# ANTHROPIC_BASE_URL/ANTHROPIC_MODEL, OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL,
# or DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL/DEEPSEEK_MODEL.
# LLM_MODEL/LLM_TEMPERATURE/LLM_MAX_TOKENS/LLM_TIMEOUT_SECONDS remain compatible.
